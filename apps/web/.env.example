# ==============================================================================
# EASYLIFE WEB APPLICATION — ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to `apps/web/.env.local` and supply your real credentials.
# NEVER commit `.env.local` or expose server-only secrets to client code.
# ==============================================================================

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Central Supabase Backend (Public Client Keys — Protected by PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Admin Key (SERVER ONLY — Never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API for AI Problem Categorization (SERVER ONLY)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Resend Transactional Email (SERVER ONLY)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Paystack Payment Integration (Future / MVP Hook)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Firebase Cloud Messaging (SERVER ONLY)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
